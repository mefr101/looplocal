# Copy this to .env on the server and fill it in. Never commit .env.

# Your site's address, with no https://. Examples: looplocal.example.com
# or, with no domain of your own, <your-server-ip>.sslip.io (for example 203.0.113.7.sslip.io).
DOMAIN=

# A long random string. Make one with: openssl rand -hex 32
# Changing it signs everyone out.
SESSION_SECRET=
