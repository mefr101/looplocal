# Copy to .env (or set these in your host's dashboard). All are optional locally.

PORT=3000
NODE_ENV=development

# Where the SQLite file and uploaded photos live.
# On a host, point both at a persistent volume (e.g. /data/looplocal.db, /data/uploads).
DB_PATH=./data/looplocal.db
UPLOAD_DIR=./uploads

# Required in production. Use a long random string.
SESSION_SECRET=change-me
